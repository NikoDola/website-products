# Local development works without external API keys. Never enable this on a host.
# Local saves support localhost:3001 and 127.0.0.1:3001 automatically.
# Hosting requires the exact HTTPS admin origin, without a trailing slash.
ADMIN_ORIGIN=http://127.0.0.1:3001
ADMIN_ALLOW_LOCAL=true
# Leave empty for local SQLite. REQUIRED for hosted Vercel (persistent D1 backend).
PLATFORM_API_URL=
PLATFORM_API_TOKEN=
# Hosted owner identity. Exact team hostname, application audience and email list.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ADMIN_ALLOWED_EMAILS=
# Stripe tracking only. Use a restricted read key where possible. No charge creation.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monitoring runs only for enabled sites AND these exact approved hosts.
MONITOR_ALLOWED_HOSTS=breeze-full.vercel.app,www.breezehc.com,breeze-live-api.nikodola.workers.dev
# Per-site read-only CMS credentials, JSON object. Never use CMS_WRITE_TOKEN here.
CMS_MONITOR_TOKENS_JSON={}
# Optional absolute path; default admin/.data/platform.sqlite
PLATFORM_DB_PATH=
# Optional marketing JSON path; defaults to admin/.data/marketing.json locally.
# Hosting requires an absolute path on a persistent Node server / mounted volume.
# This file is separate from the SQLite/D1 export. Download Marketing > JSON backup.
MARKETING_DATA_PATH=
# Optional enigma homepage configuration. Local page: http://127.0.0.1:3001/home
# Hosted contact submissions require an exact HTTPS origin and persistent inbox.
HOME_PUBLIC_ORIGIN=
HOME_INQUIRIES_DATA_PATH=
# Enable only behind an edge that overwrites country/client-IP headers and blocks bypass.
HOME_TRUST_COUNTRY_HEADER=false
HOME_COUNTRY_HEADER=cf-ipcountry
# Local-only geographic preview on /home, if no manual language cookie:
# HOME_DEV_COUNTRY=MK
